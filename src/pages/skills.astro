
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { portfolios } from "../content/portfolio";

const russianPortfolio = portfolios.ru;
const englishPortfolio = portfolios.en;

const russianSkills = russianPortfolio.skills;
const englishSkills = englishPortfolio.skills;

const russianDisplay = russianSkills.display;
const englishDisplay = englishSkills.display;
---

<BaseLayout portfolio={russianPortfolio}>
  <main class="skills-page">

    <div data-page-language="ru">
      <header class="page-header">
        <p class="page-label">Навыки</p>

        {
          russianSkills.introduction.enabled && (
            <div class="skills-introduction">
              <h1>{russianSkills.introduction.title}</h1>
              <p>{russianSkills.introduction.text}</p>
            </div>
          )
        }
      </header>

      {
        russianDisplay.enabled && (
          <div
            class:list={[
              "skills-list",
              {
                "has-introduction": russianSkills.introduction.enabled,
              },
            ]}
          >

            {
              russianSkills.items.map((item, index) => (
                <article class="skills-item">

                  <div class="skills-number">
                    {String(index + 1).padStart(2, "0")}
                  </div>

                  <div class="skills-content">

                    {
                      russianDisplay.category && (
                        <h2>{item.category}</h2>
                      )
                    }

                    {
                      russianDisplay.skills &&
                      item.skills?.length > 0 && (
                        <ul class="skills-list-items">
                          {item.skills.map((skill) => (
                            <li>{skill}</li>
                          ))}
                        </ul>
                      )
                    }

                  </div>

                </article>
              ))
            }

            {
              russianDisplay.languages &&
              russianSkills.languages?.length > 0 && (
                <article class="skills-item skills-languages">

                  <div class="skills-number">
                    {String(russianSkills.items.length + 1).padStart(2, "0")}
                  </div>

                  <div class="skills-content">

                    <h2>Владение языками</h2>

                    <ul class="skills-language-list">
                      {russianSkills.languages.map((item) => (
                        <li>
                          <span class="language-name">
                            {item.language}
                          </span>

                          <span class="language-level">
                            {item.level}
                          </span>
                        </li>
                      ))}
                    </ul>

                  </div>

                </article>
              )
            }

          </div>
        )
      }
    </div>

    <div data-page-language="en">
      <header class="page-header">
        <p class="page-label">Skills</p>

        {
          englishSkills.introduction.enabled && (
            <div class="skills-introduction">
              <h1>{englishSkills.introduction.title}</h1>
              <p>{englishSkills.introduction.text}</p>
            </div>
          )
        }
      </header>

      {
        englishDisplay.enabled && (
          <div
            class:list={[
              "skills-list",
              {
                "has-introduction": englishSkills.introduction.enabled,
              },
            ]}
          >

            {
              englishSkills.items.map((item, index) => (
                <article class="skills-item">

                  <div class="skills-number">
                    {String(index + 1).padStart(2, "0")}
                  </div>

                  <div class="skills-content">

                    {
                      englishDisplay.category && (
                        <h2>{item.category}</h2>
                      )
                    }

                    {
                      englishDisplay.skills &&
                      item.skills?.length > 0 && (
                        <ul class="skills-list-items">
                          {item.skills.map((skill) => (
                            <li>{skill}</li>
                          ))}
                        </ul>
                      )
                    }

                  </div>

                </article>
              ))
            }

            {
              englishDisplay.languages &&
              englishSkills.languages?.length > 0 && (
                <article class="skills-item skills-languages">

                  <div class="skills-number">
                    {String(englishSkills.items.length + 1).padStart(2, "0")}
                  </div>

                  <div class="skills-content">

                    <h2>Languages</h2>

                    <ul class="skills-language-list">
                      {englishSkills.languages.map((item) => (
                        <li>
                          <span class="language-name">
                            {item.language}
                          </span>

                          <span class="language-level">
                            {item.level}
                          </span>
                        </li>
                      ))}
                    </ul>

                  </div>

                </article>
              )
            }

          </div>
        )
      }
    </div>

  </main>
</BaseLayout>
