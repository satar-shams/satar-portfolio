
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { portfolios } from "../content/portfolio";
import { assetPath } from "../utils/paths";

const russianPortfolio = portfolios.ru;
const englishPortfolio = portfolios.en;

const russianCv = russianPortfolio.cv;
const englishCv = englishPortfolio.cv;

const russianDisplay = russianCv.display;
const englishDisplay = englishCv.display;
---

<BaseLayout portfolio={russianPortfolio}>
  <main class="cv-page">

    <div data-page-language="ru">
      <header class="page-header">
        <p class="page-label">Резюме</p>

        {
          russianCv.introduction.enabled && (
            <div class="cv-introduction">
              <h1>{russianCv.introduction.title}</h1>
              <p>{russianCv.introduction.text}</p>
            </div>
          )
        }
      </header>

      {
        russianDisplay.enabled && (
          <div
            class:list={[
              "cv-content",
              {
                "has-introduction": russianCv.introduction.enabled,
              },
            ]}
          >

            {
              russianDisplay.document && russianCv.document?.file && (
                <section class="cv-document">

                  <iframe
                    src={assetPath(`documents/cv/${russianCv.document.file}`)}
                    title={russianCv.document.title}
                    loading="lazy"
                  ></iframe>

                  {
                    russianDisplay.download && (
                      <a
                        class="cv-download"
                        href={assetPath(`documents/cv/${russianCv.document.file}`)}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {russianCv.download.label} →
                      </a>
                    )
                  }

                </section>
              )
            }

          </div>
        )
      }
    </div>

    <div data-page-language="en">
      <header class="page-header">
        <p class="page-label">CV</p>

        {
          englishCv.introduction.enabled && (
            <div class="cv-introduction">
              <h1>{englishCv.introduction.title}</h1>
              <p>{englishCv.introduction.text}</p>
            </div>
          )
        }
      </header>

      {
        englishDisplay.enabled && (
          <div
            class:list={[
              "cv-content",
              {
                "has-introduction": englishCv.introduction.enabled,
              },
            ]}
          >

            {
              englishDisplay.document && englishCv.document?.file && (
                <section class="cv-document">

                  <iframe
                    src={assetPath(`documents/cv/${englishCv.document.file}`)}
                    title={englishCv.document.title}
                    loading="lazy"
                  ></iframe>

                  {
                    englishDisplay.download && (
                      <a
                        class="cv-download"
                        href={assetPath(`documents/cv/${englishCv.document.file}`)}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {englishCv.download.label} →
                      </a>
                    )
                  }

                </section>
              )
            }

          </div>
        )
      }
    </div>

  </main>
</BaseLayout>
