---
import BaseLayout from "../layouts/BaseLayout.astro";
import { portfolio } from "../content/portfolio";
---

<BaseLayout>
  <main class="about-page">
    <header class="page-header">
      <p class="page-label">About</p>

      <h1>{portfolio.site.name}</h1>

      <p class="page-title">{portfolio.site.title}</p>
    </header>

    <div class="about-content">
      {
        portfolio.about.introduction.enabled && (
          <section class="about-section">
            <h2>{portfolio.about.introduction.title}</h2>
            <p>{portfolio.about.introduction.text}</p>
          </section>
        )
      }

      {
        portfolio.about.engineering_focus.enabled && (
          <section class="about-section">
            <h2>{portfolio.about.engineering_focus.title}</h2>

            <ul class="focus-list">
              {portfolio.about.engineering_focus.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        portfolio.about.approach.enabled && (
          <section class="about-section">
            <h2>{portfolio.about.approach.title}</h2>
            <p>{portfolio.about.approach.text}</p>
          </section>
        )
      }
    </div>
  </main>
</BaseLayout>