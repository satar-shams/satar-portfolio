
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { portfolios } from "../content/portfolio";
import { assetPath } from "../utils/paths";

const russianPortfolio = portfolios.ru;
const englishPortfolio = portfolios.en;

const russianAwards = russianPortfolio.awards;
const englishAwards = englishPortfolio.awards;

const russianDisplay = russianAwards.display;
const englishDisplay = englishAwards.display;
---

<BaseLayout portfolio={russianPortfolio}>
  <main class="awards-page">

    <div data-page-language="ru">
      <header class="page-header">
        <p class="page-label">Награды</p>

        {
          russianAwards.introduction.enabled && (
            <div class="awards-introduction">
              <h1>{russianAwards.introduction.title}</h1>
              <p>{russianAwards.introduction.text}</p>
            </div>
          )
        }
      </header>

      {
        russianDisplay.enabled && (
          <div
            class:list={[
              "awards-list",
              {
                "has-introduction": russianAwards.introduction.enabled,
              },
            ]}
          >
            {russianAwards.items.map((item, index) => (
              <article class="award-item">

                <div class="award-number">
                  {String(index + 1).padStart(2, "0")}
                </div>

                <div class="award-content">

                  {
                    russianDisplay.title && (
                      <h2>{item.title}</h2>
                    )
                  }

                  {
                    russianDisplay.organization &&
                    item.organization && (
                      <p class="award-organization">
                        {item.organization}
                      </p>
                    )
                  }

                  {
                    russianDisplay.year &&
                    item.year && (
                      <p class="award-year">
                        {item.year}
                      </p>
                    )
                  }

                  {
                    russianDisplay.description &&
                    item.description && (
                      <p class="award-description">
                        {item.description}
                      </p>
                    )
                  }

                  {
                    russianDisplay.image &&
                    item.image?.length > 0 && (
                      <div class="award-images">

                        {item.image.map((image) => (
                          <img
                            src={assetPath(`images/awards/${image}`)}
                            alt={item.title}
                          />
                        ))}

                      </div>
                    )
                  }

                  {
                    russianDisplay.documents &&
                    item.documents?.length > 0 && (
                      <div class="award-documents">

                        {item.documents.map((document) => (
                          <div class="award-document">
                            <iframe
                              src={assetPath(`documents/awards/${document}`)}
                              title={`${item.title} — документ`}
                              loading="lazy"
                            ></iframe>

                            <a
                              href={assetPath(`documents/awards/${document}`)}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              Открыть документ полностью →
                            </a>
                          </div>
                        ))}

                      </div>
                    )
                  }

                  {
                    russianDisplay.links &&
                    item.links?.length > 0 && (
                      <div class="award-links">

                        {item.links.map((link) => (
                          <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {link.label} →
                          </a>
                        ))}

                      </div>
                    )
                  }

                </div>

              </article>
            ))}
          </div>
        )
      }
    </div>

    <div data-page-language="en">
      <header class="page-header">
        <p class="page-label">Awards</p>

        {
          englishAwards.introduction.enabled && (
            <div class="awards-introduction">
              <h1>{englishAwards.introduction.title}</h1>
              <p>{englishAwards.introduction.text}</p>
            </div>
          )
        }
      </header>

      {
        englishDisplay.enabled && (
          <div
            class:list={[
              "awards-list",
              {
                "has-introduction": englishAwards.introduction.enabled,
              },
            ]}
          >
            {englishAwards.items.map((item, index) => (
              <article class="award-item">

                <div class="award-number">
                  {String(index + 1).padStart(2, "0")}
                </div>

                <div class="award-content">

                  {
                    englishDisplay.title && (
                      <h2>{item.title}</h2>
                    )
                  }

                  {
                    englishDisplay.organization &&
                    item.organization && (
                      <p class="award-organization">
                        {item.organization}
                      </p>
                    )
                  }

                  {
                    englishDisplay.year &&
                    item.year && (
                      <p class="award-year">
                        {item.year}
                      </p>
                    )
                  }

                  {
                    englishDisplay.description &&
                    item.description && (
                      <p class="award-description">
                        {item.description}
                      </p>
                    )
                  }

                  {
                    englishDisplay.image &&
                    item.image?.length > 0 && (
                      <div class="award-images">

                        {item.image.map((image) => (
                          <img
                            src={assetPath(`images/awards/${image}`)}
                            alt={item.title}
                          />
                        ))}

                      </div>
                    )
                  }

                  {
                    englishDisplay.documents &&
                    item.documents?.length > 0 && (
                      <div class="award-documents">

                        {item.documents.map((document) => (
                          <div class="award-document">
                            <iframe
                              src={assetPath(`documents/awards/${document}`)}
                              title={`${item.title} document`}
                              loading="lazy"
                            ></iframe>

                            <a
                              href={assetPath(`documents/awards/${document}`)}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              Open Full Document →
                            </a>
                          </div>
                        ))}

                      </div>
                    )
                  }

                  {
                    englishDisplay.links &&
                    item.links?.length > 0 && (
                      <div class="award-links">

                        {item.links.map((link) => (
                          <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {link.label} →
                          </a>
                        ))}

                      </div>
                    )
                  }

                </div>

              </article>
            ))}
          </div>
        )
      }
    </div>

  </main>
</BaseLayout>
