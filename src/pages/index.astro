---
import BaseLayout from "../layouts/BaseLayout.astro";
import { portfolio } from "../content/portfolio";
---

<BaseLayout>
  <main class="home-page">
    <section class="hero">
      <div class="hero-intro">
        <p class="hero-name">{portfolio.site.name}</p>
        <div class="hero-title">
          <span class="hero-notation hero-notation-left">Σ wᵢxᵢ</span>
          <span class="hero-arrow">→</span>
          <span class="hero-role">{portfolio.site.title}</span>
          <span class="hero-arrow">→</span>
          <span class="hero-notation hero-notation-right">ŷ</span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>