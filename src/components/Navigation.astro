```astro
---
import { portfolio } from "../content/portfolio";

const { navigation } = portfolio;

const navigationItems = Object.values(navigation);

const currentPath = Astro.url.pathname;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

const normalizePath = (path: string) => {
  const normalized = path.replace(/\/$/, "");
  return normalized || "/";
};
---

<header class="site-header">
  <a
    href={import.meta.env.BASE_URL}
    class="home-mark"
    aria-label="Home"
  >
    <span class="home-label">Home</span>
    <span class="home-tagline">is where you fall in love.</span>
  </a>

  <nav class="site-navigation" aria-label="Main navigation">
    {
      navigationItems
        .filter((item) => item.enabled)
        .map((item) => {
          const href = `${basePath}/${item.href.replace(/^\//, "")}`;
          const isActive =
            normalizePath(currentPath) === normalizePath(href);

          return (
            <a
              href={href}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
    }
  </nav>
</header>
```
