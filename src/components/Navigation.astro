---
import { portfolio } from "../content/portfolio";

const { navigation } = portfolio;

const navigationItems = Object.values(navigation);

const currentPath = Astro.url.pathname;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

const normalizePath = (path: string) => {
  const normalized = path.replace(/\/$/, "");
  return normalized || "/";
};
---

<header class="site-header">
  <a
    href={import.meta.env.BASE_URL}
    class="home-mark"
    aria-label="Дом"
  >
    <span class="home-label">Дом</span>
    <span class="home-tagline">там, где рождается любовь.</span>
  </a>

  <nav class="site-navigation" aria-label="Основная навигация">
    {
      navigationItems
        .filter((item) => item.enabled)
        .map((item) => {
          const href = `${basePath}/${item.href.replace(/^\//, "")}`;
          const isActive =
            normalizePath(currentPath) === normalizePath(href);

          return (
            <a
              href={href}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
    }

    <a
      href="https://satar-shams.github.io/satar-portfolio-en/"
      class="language-link"
      aria-label="Английская версия"
    >
      EN
    </a>
  </nav>
</header>